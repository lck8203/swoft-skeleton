{
  "name": "lck/swoft",
  "type": "project",
  "keywords": [
    "php",
    "swoole",
    "swoft",
    "php84"
  ],
  "description": "Swoft skeleton application, PHP 8.4 ready maintained fork",
  "license": "Apache-2.0",
  "require": {
    "php": ">=7.4",
    "ext-pdo": "*",
    "ext-redis": "*",
    "ext-json": "*",
    "ext-simplexml": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "lck/swoft-cache": "~2.0.13",
    "lck/swoft-db": "~2.0.13",
    "lck/swoft-i18n": "~2.0.13",
    "lck/swoft-view": "~2.0.13",
    "lck/swoft-task": "~2.0.13",
    "lck/swoft-redis": "~2.0.13",
    "lck/swoft-framework": "~2.0.13",
    "lck/swoft-http-server": "~2.0.13",
    "lck/swoft-rpc-client": "~2.0.13",
    "lck/swoft-rpc-server": "~2.0.13",
    "lck/swoft-websocket-server": "~2.0.13",
    "lck/swoft-tcp-server": "~2.0.13",
    "lck/swoft-process": "~2.0.13",
    "lck/swoft-apollo": "~2.0.13",
    "lck/swoft-consul": "~2.0.13",
    "lck/swoft-limiter": "~2.0.13",
    "lck/swoft-breaker": "~2.0.13",
    "lck/swoft-crontab": "~2.0.13",
    "lck/swoft-session": "~2.0.13",
    "lck/swoft-devtool": "~2.0.13"
  },
  "require-dev": {
    "lck/swoft-swlib": "~2.0.13",
    "lck/swoft-swoole-ide-helper": "~2.0.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\": "database/"
    },
    "files": [
      "app/Helper/Functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "AppTest\\Testing\\": "test/testing",
      "AppTest\\Unit\\": "test/unit"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php -r \"if (is_dir('.git')) { echo 'Removing VCS history...', PHP_EOL; shell_exec('rm -rf .git'); }\""
    ]
  }
}
